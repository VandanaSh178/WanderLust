<% layout("/layouts/boilerplate") %>

<h3>Edit your Listing</h3>

<a href="/listings">← Back to listings</a>
<br /><br />

<form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation">
  <div class="row">

    <div class="col-md-6 mb-3">
      <label for="title" class="form-label">Title</label>
      <input
        id="title"
        name="listing[title]"
        type="text"
        value="<%= listing.title %>"
        required
        class="form-control"
      />
      <div class="invalid-feedback">Please enter a title.</div>
    </div>

    <div class="col-md-6 mb-3">
      <label for="price" class="form-label">Price (in INR)</label>
      <input
        id="price"
        name="listing[price]"
        type="number"
        min="0"
        value="<%= listing.price %>"
        required
        class="form-control"
      />
      <div class="invalid-feedback">Please enter a price.</div>
    </div>

    <div class="col-12 mb-3">
      <label for="description" class="form-label">Description</label>
      <textarea
        id="description"
        name="listing[description]"
        required
        class="form-control"
      ><%= listing.description %></textarea>
      <div class="invalid-feedback">Please enter a description.</div>
    </div>

    <div class="col-md-6 mb-3">
      <label for="image" class="form-label">Image URL</label>
      <input
        id="image"
        name="listing[image]"
        type="text"
        value="<%= listing.image %>"
        class="form-control"
        required
      />
      <div class="invalid-feedback">Please enter an image URL.</div>
    </div>

    <div class="col-md-3 mb-3">
      <label for="country" class="form-label">Country</label>
      <input
        id="country"
        name="listing[country]"
        type="text"
        value="<%= listing.country %>"
        required
        class="form-control"
      />
      <div class="invalid-feedback">Please enter a country.</div>
    </div>

    <div class="col-md-3 mb-3">
      <label for="location" class="form-label">Location</label>
      <input
        id="location"
        name="listing[location]"
        type="text"
        value="<%= listing.location %>"
        required
        class="form-control"
      />
      <div class="invalid-feedback">Please enter a location.</div>
    </div>

  </div>

  <br />
  <button class="btn btn-dark add-btn">Update</button>
</form>
